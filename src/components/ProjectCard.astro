---
interface Props {
  title: string;
  slug: string;
  description: string;
  tags: string[];
  status: 'live' | 'wip' | 'concept';
  url?: string;
  index?: number;
}

const { title, slug, description, tags, status, url, index = 0 } = Astro.props;

const statusLabel = { live: 'Live', wip: 'WIP', concept: 'Concept' }[status];
const category = tags.includes('pf2e') ? 'PF2e Tool' : tags.includes('web') ? 'Web App' : 'Tool';
---

<a
  href={`/projects/${slug}`}
  class="card"
  style={`animation-delay: ${index * 0.07}s`}
  data-tags={tags.join(',')}
>
  <div class="card-meta">
    <span class="card-category">{category}</span>
    <span class="card-dot"></span>
    <span class={`status status-${status}`}>{statusLabel}</span>
  </div>

  <div class="card-body">
    <h2>{title}</h2>
    <p>{description}</p>
  </div>

  <div class="card-footer">
    <div class="card-tags">
      {tags.map(t => <span class="tag">{t}</span>)}
    </div>
    <span class="card-arrow">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
        <path d="M5 12h14M12 5l7 7-7 7"/>
      </svg>
    </span>
  </div>
</a>

<style>
  .card {
    display: flex;
    flex-direction: column;
    gap: 12px;
    background: var(--bg-card);
    border: 1px solid var(--rule);
    border-radius: var(--radius);
    padding: 26px 28px;
    text-decoration: none;
    color: inherit;
    position: relative;
    overflow: hidden;
    transition: box-shadow 0.25s, transform 0.25s;
    animation: fadeUp 0.45s ease both;
  }

  .card::before {
    content: '';
    position: absolute;
    left: 0; top: 0; bottom: 0;
    width: 3px;
    background: var(--accent);
    transform: scaleY(0);
    transform-origin: bottom;
    transition: transform 0.3s ease;
  }

  .card:hover {
    box-shadow: 0 6px 28px rgba(0,0,0,0.09);
    transform: translateY(-3px);
    text-decoration: none;
  }

  .card:hover::before {
    transform: scaleY(1);
  }

  .card-meta {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .card-category {
    font-family: 'Cinzel', serif;
    font-size: 0.6rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink-muted);
  }

  .card-dot {
    width: 3px; height: 3px;
    background: var(--rule);
    border-radius: 50%;
  }

  .card-body h2 {
    font-size: 1.15rem;
    font-weight: 600;
    letter-spacing: 0.03em;
    color: var(--ink);
    margin-bottom: 6px;
  }

  .card-body p {
    font-size: 0.92rem;
    color: var(--ink-muted);
    font-weight: 300;
    line-height: 1.55;
  }

  .card-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-top: 4px;
  }

  .card-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  .card-arrow {
    color: var(--rule);
    transition: color 0.2s, transform 0.2s;
    flex-shrink: 0;
  }

  .card:hover .card-arrow {
    color: var(--accent);
    transform: translateX(3px);
  }
</style>
